## ceph.conf
[global]
fsid = fixture-fsid
mon host = [v2:192.0.2.12:3300]
mon initial members = a


auth cluster required = cephx
auth service required = cephx
auth client required = cephx
auth allow insecure global id reclaim = false
log to file = false
log to stderr = true
err to stderr = true
mon cluster log to file = false
mon cluster log to stderr = true
# Crash reports stay where CollectCrashMetadata reads them, also after a
# daemon exits; the MON configuration database cannot move them.
crash dir = <root>/var/lib/ceph/crash
osd pool default size = 2
osd pool default min size = 1
osd pool default pg num = 8
osd pool default pgp num = 0
osd pool default pg autoscale mode = off
mon allow pool size one = true
ms bind ipv4 = true
ms bind ipv6 = false
# Report daemon and PG statistics every second instead of five, so readiness
# waits observe new PG states sooner in this small disposable cluster.
mgr stats period = 1
ms cluster mode = secure
ms service mode = secure
ms client mode = secure
ms mon cluster mode = secure
ms mon service mode = secure
ms mon client mode = secure
ms bind msgr1 = false
ms bind msgr2 = true
[mon]
[osd]
osd objectstore = bluestore
memstore device bytes = 1073741824
bluestore block create = true
bluestore block size = 1073741824
bluestore block preallocate file = false
bluestore cache autotune = false
bluestore cache size = 67108864
osd crush chooseleaf type = 0
osd max object name len = 256
osd max object namespace len = 64
## mon.sh native commands
BEGIN:ceph-authtool
--create-keyring
<root>/etc/ceph/mon.keyring
--gen-key
-n
mon.
--cap
mon
allow *
END
BEGIN:ceph-authtool
--create-keyring
<root>/etc/ceph/ceph.client.admin.keyring
--gen-key
-n
client.admin
--cap
mon
allow *
--cap
osd
allow *
--cap
mgr
allow *
--cap
mds
allow *
END
BEGIN:ceph-authtool
<root>/etc/ceph/mon.keyring
--import-keyring
<root>/etc/ceph/ceph.client.admin.keyring
END
BEGIN:monmaptool
--create
--fsid
fixture-fsid
--addv
a
[v2:192.0.2.12:3300]
<root>/tmp/monmap
END
BEGIN:ceph-mon
--mkfs
-i
a
--monmap
<root>/tmp/monmap
--keyring
<root>/etc/ceph/mon.keyring
END
BEGIN:ceph-mon
-f
-i
a
END
## mon-join.sh native commands
BEGIN:monmaptool
--addv
b
[v2:192.0.2.14:3300]
<root>/tc/monmap
END
BEGIN:ceph-mon
--mkfs
-i
b
--monmap
<root>/tc/monmap
--keyring
<root>/etc/ceph/mon.keyring
END
BEGIN:ceph-mon
-f
-i
b
END
